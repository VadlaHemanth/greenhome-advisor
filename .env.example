# Local portfolio demo. Never commit real keys or database URLs.
GREENHOME_PUBLIC_MODE=false
GREENHOME_LIVE_LLM=false
GREENHOME_LIVE_GEMINI=false
GREENHOME_LLM_PROVIDER=xkiro
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3.8-max:free
GEMINI_API_KEY=
GEMINI_MODEL=
GREENHOME_ALLOWED_ORIGINS=http://127.0.0.1:8016,http://localhost:8016
GREENHOME_ALLOWED_HOSTS=localhost,127.0.0.1
GREENHOME_CALC_WORKERS=2
GREENHOME_CALC_CAPACITY=64
# Hosted Vercel entry requires persistent Postgres and defaults to local explanations.
DATABASE_URL=
# Optional local Postgres adapter:
# GREENHOME_WORKSPACE_DATABASE_URL=postgresql+psycopg://...
# GREENHOME_PROVIDER_BUDGET_DATABASE_URL=postgresql+psycopg://...
